---
// The "TO-DO LIST" meme, rebuilt natively — crisp at any size, animated, 3·6·9.
---
<div class="todo-meme rv">
  <div class="todo-paper" role="img" aria-label="To-do list: buy ZAPP, hold ZAPP, repeat 3 6 9">
    <span class="todo-tape" aria-hidden="true"></span>
    <h3 class="todo-title">To-Do List</h3>
    <ul class="todo-items">
      <li class="todo-i" style="--i:0"><span class="todo-box"><svg viewBox="0 0 32 32"><path d="M5 17 L13 25 L28 7"/></svg></span><span class="todo-txt">Buy <b class="zb">⚡ZAPP</b></span></li>
      <li class="todo-i" style="--i:1"><span class="todo-box"><svg viewBox="0 0 32 32"><path d="M5 17 L13 25 L28 7"/></svg></span><span class="todo-txt">Hold <b class="zb">⚡ZAPP</b></span></li>
      <li class="todo-i" style="--i:2"><span class="todo-box"><svg viewBox="0 0 32 32"><path d="M5 17 L13 25 L28 7"/></svg></span><span class="todo-txt">Repeat <b class="z369">3 · 6 · 9 ∞</b></span></li>
    </ul>
    <img class="todo-mascot" src="/img/zapp-mascot.png" alt="" loading="lazy" width="120" height="120" />
    <span class="todo-pencil" aria-hidden="true">✏️</span>
  </div>
  <p class="todo-cap">Three steps. The 3 of 3 · 6 · 9.</p>
</div>
