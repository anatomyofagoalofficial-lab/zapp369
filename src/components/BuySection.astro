---
const { showSwap = false, showKit = false, sub = 'Live on Solana. Community owned. The signal is open.', disc = '⚡ZAPP is a community memecoin. It can lose all its value. Not financial advice. 3 · 6 · 9 ∞', showMsg = true } = Astro.props;
const CA = 'Ab16ce5SDbibTbXevxHLpqUnUvu9tNkkpaJcSDvCpump';
const PUMP = `https://pump.fun/coin/${CA}`;
const PHANTOM = `https://phantom.com/tokens/solana/${CA}?referralId=k31pepyasnt`;
const JUP = `https://jup.ag/tokens/${CA}`;
const DEX = `https://dexscreener.com/solana/${CA}`;
const RUG = `https://rugcheck.xyz/tokens/${CA}`;
---
<div class="buy-section" id="buy-section">
  <div class="buy-glow"></div>
  <div class="buy-in">
    <p class="buy-eyebrow rv">3 · 6 · 9 · ∞</p>
    <h2 class="buy-h rv">Join the<br><em>frequency</em>.</h2>
    <p class="buy-sub rv d1">{sub}</p>
    <div class="ca-pill rv d2" data-copy-ca>
      <div class="ca-tick" aria-hidden="true"></div>
      <div><span class="ca-l">Contract Address · Solana</span><div class="ca-a">{CA}</div></div>
      <span class="ca-i">⎘</span>
    </div>
    {showMsg && <div id="ca-msg" style="opacity:0"></div>}
    {showSwap && <div id="jup-terminal" class="jup-box rv d2" aria-label="Swap to ZAPP"></div>}
    <script is:inline define:vars={{ CA }}>
      (function(){
        var done=false;
        function boot(){ if(done) return; done=true;
          var sc=document.createElement('script'); sc.src='https://plugin.jup.ag/plugin-v1.js'; sc.async=true;
          sc.onload=function(){ try{ window.Jupiter && window.Jupiter.init({ displayMode:'integrated', integratedTargetId:'jup-terminal', formProps:{ initialOutputMint: CA, swapMode:'ExactIn' } }); }catch(e){} };
          document.head.appendChild(sc);
        }
        var el=document.getElementById('jup-terminal'); if(!el) return;
        if('IntersectionObserver' in window && el){ new IntersectionObserver(function(es,o){ es.forEach(function(e){ if(e.isIntersecting){ boot(); o.disconnect(); } }); },{rootMargin:'400px'}).observe(el); }
        else setTimeout(boot,4000);
      })();
    </script>
    <div class="buy-btns rv d2">
      <a href={PUMP} target="_blank" rel="noopener" class="bg">Buy on Pump.fun ⚡</a>
      <a href={PHANTOM} target="_blank" rel="noopener" class="bo">Phantom</a>
    </div>
    <div class="buy-lnks rv d3">
      <a href={JUP} target="_blank" rel="noopener" class="bl sol">Jupiter</a>
      <a href={DEX} target="_blank" rel="noopener" class="bl">Chart</a>
      <a href="/whitepaper" target="_blank" rel="noopener" class="bl">Whitepaper</a>
      <a href={RUG} target="_blank" rel="noopener" class="bl">RugCheck ✓</a>
      <a href="/era-currents" class="bl">Art Lab ⚡</a>
    </div>
    <div class="socials rv d3">
      <a href="https://t.me/ZAPP369" target="_blank" rel="noopener" class="sc">TG</a>
      <a href="https://x.com/ZAPPonSOL" target="_blank" rel="noopener" class="sc">𝕏</a>
      <a href="https://www.instagram.com/zapp369.energy/" target="_blank" rel="noopener" class="sc">IG</a>
    </div>
    {showKit && <div class="meme-kit rv d3"><p class="mk-l">⚡ Meme Kit · take him everywhere</p><div class="mk-row"><a href="/img/zapp-mascot.png" download class="mk-i"><img src="/img/zapp-mascot.png" alt="ZAPP mascot" loading="lazy"></a><a href="/illustrations/tribute.jpg" download class="mk-i"><img src="/illustrations/tribute.jpg" alt="Tribute" loading="lazy"></a><a href="/illustrations/torch-v2.jpg" download class="mk-i"><img src="/illustrations/torch-v2.jpg" alt="Torch" loading="lazy"></a></div></div>}
    <p class="official rv d4">Official · zapp369.energy · t.me/ZAPP369 · x.com/ZAPPonSOL · trust no other links</p>
    <p class="disc rv d4">{disc}</p>
  </div>
</div>
