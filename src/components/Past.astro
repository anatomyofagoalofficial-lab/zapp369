---
// 3 · PAST — "Enter the Laboratory" (immersive walk-in).
// Full-viewport WebGL scene (src/scene/past-lab.ts) fixed behind the page; scroll
// drives the camera FORWARD into Tesla's 1899 lab and out to the Wardenclyffe Tower.
// Global nav comes from <DimNav/> in tower.astro. Pure homage — no token content here
// (the crypto layer lives in 6 · Signal and 9 · Network).
---
<div id="dim-past" class="page past-immersive">
  <!-- the world -->
  <canvas id="past-canvas"></canvas>

  <!-- narrative overlay (updated by past-lab.ts as you travel deeper) -->
  <div class="lab-ui" aria-hidden="true">
    <p id="lab-chapter">Colorado Springs · 1899</p>
    <h2 id="lab-line">Step inside the <em>laboratory</em>.</h2>
  </div>
  <div id="lab-hint" aria-hidden="true">scroll &nbsp;·&nbsp; go deeper</div>

  <!-- scroll distance: ~600vh of travel through the lab to the tower -->
  <div class="lab-track" aria-hidden="true"></div>

  <!-- arrival: the tower stands. Homage close. -->
  <section class="lab-close">
    <p class="lc-seq">3 · 6 · 9 · ∞</p>
    <h2 class="lc-head">They buried the tower.<br><em>Never the frequency.</em></h2>
    <p class="lc-sub">Nikola Tesla tried to wire the whole planet for free energy. The men with the meters tore it down. The idea outlived them — and it is still transmitting.</p>
    <div class="lc-actions">
      <a class="lc-btn lc-btn--ghost" href="/" data-hub>↵ Back to the Hub</a>
      <a class="lc-btn" href="/dimensions/signal" data-era="present">Follow the signal →</a>
    </div>
  </section>
</div>

<style>
  /* dark immersive page (the hub's palette, not parchment) */
  #dim-past{
    --glow:#F4D27A; --glow-deep:#B8902F; --ink:#050208;
    --serif:"Cormorant Garamond", Georgia, serif;
    --mono:"JetBrains Mono", monospace;
    position:relative; z-index:0; background:var(--ink); color:#f3ead6;
    font-family:var(--serif); overflow-x:hidden;
  }
  /* WebGL canvas pinned to the viewport while the page scrolls underneath it */
  #dim-past #past-canvas{
    position:fixed; inset:0; width:100vw; height:100vh; z-index:0; display:block;
  }

  /* fixed narrative overlay */
  #dim-past .lab-ui{
    position:fixed; left:0; right:0; bottom:15vh; z-index:3; text-align:center;
    pointer-events:none; padding:0 7vw;
  }
  #dim-past #lab-chapter{
    font-family:var(--mono); font-size:.72rem; letter-spacing:.4em; text-transform:uppercase;
    color:var(--glow); opacity:.85; margin-bottom:.9rem; text-shadow:0 0 16px rgba(0,0,0,.9);
    transition:opacity .8s ease;
  }
  #dim-past #lab-line{
    font-size:clamp(1.7rem,4.4vw,3.6rem); line-height:1.08; font-weight:500; color:#f6eeda;
    max-width:18ch; margin:0 auto; text-shadow:0 2px 30px rgba(0,0,0,.85);
    transition:opacity .8s ease, transform .8s ease;
  }
  #dim-past #lab-line em{ color:var(--glow); font-style:italic; }
  #dim-past #lab-hint{
    position:fixed; left:50%; bottom:30px; transform:translateX(-50%); z-index:3;
    font-family:var(--mono); font-size:.66rem; letter-spacing:.3em; text-transform:uppercase;
    color:#9a8f76; pointer-events:none; transition:opacity .6s ease;
    animation:labpulse 2.6s ease-in-out infinite;
  }
  @keyframes labpulse{0%,100%{filter:opacity(.55)}50%{filter:opacity(1)}}

  /* the scroll spacer that gives the camera room to travel */
  #dim-past .lab-track{ height:600vh; pointer-events:none; }

  /* arrival / homage close */
  #dim-past .lab-close{
    position:relative; z-index:2; min-height:118vh; display:flex; flex-direction:column;
    align-items:center; justify-content:flex-end; text-align:center; gap:1.1rem; padding:34vh 28px 9vh;
    /* keep the upper area clear so the Tower (rendered behind) is fully visible; scrim only behind the text */
    background:linear-gradient(to bottom, transparent 0%, transparent 44%, rgba(5,2,8,.4) 66%, rgba(5,2,8,.9) 100%);
  }
  #dim-past .lc-seq{ font-family:var(--mono); letter-spacing:.5em; color:var(--glow); font-size:.8rem; }
  #dim-past .lc-head{
    font-size:clamp(1.9rem,5.2vw,3.7rem); line-height:1.05; font-weight:600; letter-spacing:-.01em;
    text-shadow:0 0 40px rgba(244,210,122,.2), 0 2px 22px rgba(0,0,0,.85);
  }
  #dim-past .lc-head em{ font-style:italic; color:var(--glow); }
  #dim-past .lc-sub{
    font-style:italic; color:#c9bda3; font-size:clamp(1rem,1.8vw,1.25rem); line-height:1.7;
    max-width:48ch; margin:.4rem auto 1.2rem;
  }
  #dim-past .lc-actions{ display:flex; gap:1rem; flex-wrap:wrap; justify-content:center; }
  #dim-past .lc-btn{
    font-family:var(--mono); font-size:.74rem; letter-spacing:.18em; text-transform:uppercase;
    text-decoration:none; padding:1em 1.8em; border-radius:40px; cursor:pointer;
    color:#1a1206; background:linear-gradient(180deg,var(--glow),var(--glow-deep));
    box-shadow:0 0 24px rgba(244,210,122,.35); transition:transform .2s ease;
  }
  #dim-past .lc-btn:hover{ transform:translateY(-2px); }
  #dim-past .lc-btn--ghost{
    color:var(--glow); background:transparent; border:1px solid rgba(244,210,122,.4); box-shadow:none;
  }

  @media (prefers-reduced-motion: reduce){
    #dim-past #lab-hint{ animation:none; }
  }
</style>
