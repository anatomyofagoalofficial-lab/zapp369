---
import Base from '../layouts/Base.astro';
import Cursor from '../components/Cursor.astro';
import SoundToggle from '../components/SoundToggle.astro';
import Intro from '../components/Intro.astro';
import { DIMENSIONS } from '../scene/dimensions.config';

// number → fixed viewport corner (3 = top-left, 9 = top-right, 6 = bottom-centre)
const corner: Record<number, string> = { 3: 'card-3', 9: 'card-9', 6: 'card-6' };
// number → card icon SVG: custom gold Tesla tower (3) + brand bolt (6), Twemoji satellite (9)
const icon: Record<number, string> = { 3: 'tower-tesla', 6: 'bolt-zapp', 9: '1f6f0' };
---
<Base>
  <Intro />
  <Cursor />
  <SoundToggle />

  <div id="starmap-wrap">
    <canvas id="starmap"></canvas>

    <!-- shooting stars (CSS overlay — reliable on every GPU) -->
    <div class="shooting-stars" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <!-- warp bloom: fills with the chosen dimension's light as you dive in, so the page-swap is seamless -->
    <div id="warp-flash" aria-hidden="true"></div>

    <div class="sm-center">
      <h1 class="sm-logo">⚡ZAPP</h1>
      <div class="sm-369">∞ · 3 · 6 · 9 · ∞</div>
      <div class="sm-tag">Tesla's Revolution</div>
      <div class="sm-sub">Choose your dimension</div>
      <div class="scroll-hint" aria-hidden="true">↓</div>
    </div>

    <!-- fixed HTML overlays — anchored to the viewport, never drift with the camera -->
    <div id="dimension-cards">
      {DIMENSIONS.map(d => (
        <a class={`dimension-card ${corner[d.number]}`} href={d.route} data-go={d.route} style={`--dc:${d.color}`}>
          <span class="dc-num" aria-hidden="true">{d.number}</span>
          {d.number === 6
            ? <span class="dc-icon dc-bolt" aria-hidden="true">⚡</span>
            : <img class="dc-icon" src={`/img/emoji/${icon[d.number]}.svg`} alt="" aria-hidden="true" width="40" height="40" loading="lazy" decoding="async" />}
          <div class="dc-meta">{d.subtitle}</div>
          <div class="dc-title">{d.title}</div>
          <div class="dc-desc">{d.description}</div>
          <span class="enter-cta">Enter <span class="cta-arrow">→</span></span>
        </a>
      ))}
    </div>
  </div>

  <script>
    import { initStarMap } from '../scene/star-map';
    import { initCursor } from '../scripts/ui';
    import { initSound } from '../scripts/sound';
    import { initIntro } from '../scripts/intro';
    import { captureReferral } from '../scripts/referral';
    captureReferral();   // first-touch: a friend's ?ref=code lands here
    const cv = document.getElementById('starmap') as HTMLCanvasElement;
    if (cv) initStarMap(cv);   // star map runs behind the intro, revealed when it finishes
    initCursor();
    initSound();
    // choreographed reveal of the three dimensions, fired the moment the intro lifts
    const reveal = () => document.getElementById('dimension-cards')?.classList.add('revealed');
    // Spectacular electric ⚡ZAPP intro plays on every fresh visit. It's only skipped right
    // after returning from a dimension (a flag the dimension pages set) so it never repeats.
    let fromDim = false;
    try { fromDim = sessionStorage.getItem('zapp-from-dim') === '1'; sessionStorage.removeItem('zapp-from-dim'); } catch {}
    if (fromDim) {
      document.getElementById('intro')?.remove();
      reveal();
    } else {
      initIntro(reveal);
    }
  </script>
</Base>
