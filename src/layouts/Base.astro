---
import '../styles/global.css';
const {
  title = '⚡ZAPP · Choose Your Dimension',
  description = "Tesla's unfinished revolution, on Solana. Free energy for everyone — 3 · 6 · 9 ∞",
} = Astro.props;
const og = '/zapp-social-preview.jpg';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/img/logo_circle.png" />
  <meta name="theme-color" content="#050208" />

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:url" content="https://zapp369.energy" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />

  <!-- Prefetch the other eras + hub → era-to-era taps swap instantly (no network wait) -->
  <link rel="prefetch" href="/" />
  <link rel="prefetch" href="/dimensions/tower" />
  <link rel="prefetch" href="/dimensions/signal" />
  <link rel="prefetch" href="/dimensions/network" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <div class="grain" aria-hidden="true"></div>
  <div id="scroll-prog" aria-hidden="true"></div>
  <script is:inline>
    (function () {
      var p = document.getElementById('scroll-prog');
      if (!p) return;
      var upd = function () {
        var max = document.documentElement.scrollHeight - innerHeight;
        p.style.width = (max > 4 ? Math.min(100, (scrollY / max) * 100) : 0) + '%';
      };
      addEventListener('scroll', upd, { passive: true });
      addEventListener('resize', upd, { passive: true });
      upd();
    })();
  </script>
</body>
</html>
